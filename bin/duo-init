#!/usr/bin/env bash
# 在当前项目目录复制模板,已存在文件不覆盖
set -euo pipefail
KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$KIT/bin/duo-common.sh"
USAGE='用法: duo-init [--update]。--update 备份并更新协作规则;保留项目规范、计划、备注和任务。'
duo_options "$@"
SRC="$KIT/template"
if [ "$UPDATE" -eq 1 ]; then duo_validate AGENTS.md; fi
created=0; skipped=0
while IFS= read -r -d '' f; do
  rel="${f#$SRC/}"
  if [ -e "$rel" ]; then
    if [ "$UPDATE" -eq 1 ] && [ "$rel" = AGENTS.md ]; then
      protocol="$(mktemp)"
      trap 'rm -f "$protocol"' EXIT
      awk '/^<!-- DUO-KIT:END -->$/ { inside=0 } inside { print } /^<!-- DUO-KIT:BEGIN -->$/ { inside=1 }' "$f" > "$protocol"
      duo_upsert "$rel" "$protocol" '## 协作协议(架构师 + 突击手)'
    elif [ "$UPDATE" -eq 1 ] && [ "$rel" = .cursor/rules/main.mdc ]; then
      duo_copy "$f" "$rel"
    else
      echo "跳过(保留已有文件): $rel"; skipped=$((skipped+1))
    fi
  else
    mkdir -p "$(dirname "$rel")"
    cp "$f" "$rel"
    echo "创建: $rel"; created=$((created+1))
  fi
done < <(find "$SRC" -type f ! -name '.DS_Store' -print0)
echo "完成:创建 $created 个,跳过 $skipped 个。请编辑 AGENTS.md 填写测试命令。"
